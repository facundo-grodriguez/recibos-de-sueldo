# Variables usadas por docker-compose.yml (raíz de app/).
# Copiar a .env y completar antes de "docker compose up".

# openssl rand -base64 32
JWT_SECRET="change-me-to-a-random-secret-of-at-least-16-chars"

# openssl rand -base64 24 (nunca "recibos"/"recibos" del docker-compose de desarrollo)
POSTGRES_PASSWORD="change-me-to-a-random-password"

# Dominio público que apunta a este servidor (ej. turecibos.duckdns.org).
# Caddy lo usa para emitir el certificado HTTPS automáticamente — tiene que
# resolver por DNS a la IP del servidor antes de levantar el stack.
DOMINIO="turecibos.duckdns.org"

# Opcional pero muy recomendado: destino de rclone para la copia off-site de
# los backups (ver rclone.conf.example y README, sección "Backups"). Sin
# esto, el backup diario sigue corriendo, pero queda solo en este servidor.
# RCLONE_REMOTE="oracle:recibos-backups"

# Opcional: cuántos backups locales conservar (default 14, uno por día).
# BACKUP_RETENTION_CANTIDAD=14
