NODE_ENV=development
PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL="postgresql://recibos:recibos@localhost:5432/recibos?schema=public"

# Secreto para firmar JWT. Generar uno propio (nunca usar este valor en producción):
# openssl rand -base64 32
JWT_SECRET="change-me-to-a-random-secret-of-at-least-16-chars"
JWT_EXPIRES_IN="8h"
