NODE_ENV=development
PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL="postgresql://recibos:recibos@localhost:5432/recibos?schema=public"

# Los dos valores de abajo son placeholders — en producción el server no
# arranca si detecta que siguen así (ver env.schema.ts). Generar uno propio
# para cada uno, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# (o "openssl rand -base64 32" si tenés OpenSSL a mano).

# Secreto para firmar JWT.
JWT_SECRET="change-me-to-a-random-secret-of-at-least-16-chars"
JWT_EXPIRES_IN="8h"

# Requerido para crear cuentas nuevas (POST /auth/register); se manda como
# header X-Admin-Registration-Token. Sin esto, el registro está cerrado al
# público (ver OPERACION.md).
ADMIN_REGISTRATION_TOKEN="change-me-to-a-random-secret-of-at-least-16-chars"
